[Unit]
Description=AlphaPilot 数据库维护(备份/巡检/清理)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash /home/ubuntu/projects/alpha-pilot/data/linux_tasks/run_db_maintenance.sh
Environment=BROKER_MODE=paper
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=900

Nice=10
CPUQuota=300%
MemoryMax=8G
IOWeight=50
Environment=OMP_NUM_THREADS=3
Environment=OPENBLAS_NUM_THREADS=3
Environment=MKL_NUM_THREADS=3
