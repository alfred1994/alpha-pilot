# 长桥 OpenAPI 行情配置
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
LONGPORT_OAUTH_TOKEN_PATH=~/.longbridge/openapi/tokens/default

# 同花顺 Fuyao：显式开启且配置私有 API Key 后启用研究/日线源。
# 不作为逐股实时执行源；无 key 时零请求并保留既有源。
HITHINK_ENABLED=0
HITHINK_FINANCE_API_KEY=
# 全市场快照每页100，只在预算内完整返回时更新流动性研究池。
HITHINK_UNIVERSE_MAX_PAGES=60
# 技术形态只记录影子诊断，不影响下单评分；设0关闭。
TECHNICAL_PATTERN_SHADOW=1

# MiMo LLM
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# OpenRouter 舆情分析备用
OPENROUTER_API_KEY=

# 华泰证券 Skill
HT_APIKEY=

# Telegram 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 交易通道: paper=模拟盘。real 目前只是预留适配器，不会启用真实交易。
BROKER_MODE=paper

# 独立用户工作台：生产默认不开放；启用后访问 /workspace/。
# 不控制旧公网只读看板，也不会启动策略执行器。
ALPHAPILOT_WORKSPACE_ENABLED=0
ALPHAPILOT_WORKSPACE_ORIGIN=https://alphapilot.pp.ua
ALPHAPILOT_ALLOW_REGISTRATION=true
# 生产默认要求邮箱验证后开户/下单/启用策略；开发默认不要求。
# ALPHAPILOT_REQUIRE_VERIFIED_EMAIL=true
# 显式启用且全部配置齐全后才允许用户请求邮件，默认不会发送。
ALPHAPILOT_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
# ALPHAPILOT_WORKSPACE_DB=data/workspace.sqlite3
# 仅行情权限；美股使用 Alpaca IEX 数据，不发送券商交易请求。
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
# 独立模拟策略执行器：python -m services.workspace_runner --interval 60
# 独立净值观察器：python -m services.workspace_observer --interval 60
ALPHAPILOT_PERFORMANCE_INTERVAL_SECONDS=300

# 旁路研究默认关闭：仅记录扫描和盘后更新隔离报告，不改变交易。
RESEARCH_EVIDENCE_ENABLED=0
# 可选独立档案位置；前向实验的本地行情输入文件在创建实验时指定。
# RESEARCH_EVIDENCE_DB=data/research_evidence.db

# 快链路是否启用 LLM 决策
USE_LLM_IN_FAST=1

# 自动盯盘参数
AUTO_LOOP_INTERVAL=60
AUTO_SCAN_INTERVAL=1800
AUTO_STOP_INTERVAL=60
AUTO_REVIEW_AFTER=15:05
AUTO_NOTIFY_ENABLED=1

#同花顺数据源API KEY

# ── 数据仓库（可选，见 docs/data-warehouse.md）──
# 全市场日线回填并发数；默认按CPU/内存自适应（min(CPU,6)）
UNIVERSE_BACKFILL_WORKERS=
# k_minute 1分钟K线保留天数（默认30，0=不清理）
K_MINUTE_RETENTION_DAYS=30

# Vibe-Trading 研究层（外置 venv，进程隔离；因子库/IC基准，只读研究工具）
# 先运行 bash scripts/setup_vibe_trading.sh 安装独立 venv，详见 docs/vibe-trading.md
VIBE_TRADING_ENABLED=0
VIBE_PYTHON=
VIBE_TOOL_TIMEOUT_SECONDS=900

# Laya 影子决策层（外置 venv 本机服务；类型化决策模型，影子对照不拦截交易）
# 先运行 bash scripts/setup_laya.sh --install-service，详见 docs/laya-shadow.md
LAYA_ENABLED=0
LAYA_BASE_URL=http://127.0.0.1:8642
LAYA_TIMEOUT_SECONDS=120
